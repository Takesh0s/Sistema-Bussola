{
  "expo": {
    "name": "Bússola",
    "slug": "sistema-bussola",
    "version": "3.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bussola",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sistemabussola"
    },
    "android": {
      "package": "app.sistemabussola",
      "adaptiveIcon": {
        "backgroundColor": "#144E66",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Bússola — Clube de Desbravadores",
      "themeColor": "#144E66"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#144E66",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ]
  }
}
